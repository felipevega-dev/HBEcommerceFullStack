# Harry's Boutique - variables de entorno para produccion (Vercel + Supabase).
# Configura estos valores en el panel de secretos del proveedor; no los subas al repo.

# ─── Base de datos (obligatorio) ──────────────────────────────────────────────
# Runtime con transaction pooler; migraciones (`npm run db:migrate:deploy`) con DIRECT_URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ─── Autenticacion y dominio (obligatorio) ────────────────────────────────────
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://www.tu-dominio.cl"
NEXT_PUBLIC_FRONTEND_URL="https://www.tu-dominio.cl"

# ─── Imagenes (obligatorio) ───────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─── MercadoPago (obligatorio, credenciales de PRODUCCION) ────────────────────
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Webhook: https://www.tu-dominio.cl/api/mercadopago/webhook
MERCADOPAGO_WEBHOOK_SECRET=""
ORDER_STOCK_RESERVATION_MINUTES="60"

# ─── Emails con Resend (obligatorio, dominio verificado con SPF/DKIM/DMARC) ───
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Harry's Boutique <noreply@tu-dominio.cl>"
CONTACT_EMAIL="contacto@tu-dominio.cl"

# ─── Supabase (opcional) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ─── Rate limiting (recomendado en produccion multi-instancia) ───────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Observabilidad (recomendado) ─────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_GA_ID=""

# ─── Instagram (opcional) ─────────────────────────────────────────────────────
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_GRAPH_API_VERSION="v21.0"

# ─── Solo para docker-compose.prod.yml (VM con Docker) ────────────────────────
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD=""
# POSTGRES_DB="harrys_boutique"
# APP_PORT="3000"
