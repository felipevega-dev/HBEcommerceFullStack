# Harry's Boutique - variables de entorno para desarrollo local.
# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.
#
# `npm run dev` exige una base Supabase (directa o pooler) en DATABASE_URL y
# DIRECT_URL; usa un proyecto o branch de Supabase que NO sea produccion.

# ─── Base de datos (obligatorio) ──────────────────────────────────────────────
# Runtime: transaction pooler (puerto 6543). Migraciones: conexion directa (5432).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# ─── Autenticacion (obligatorio) ──────────────────────────────────────────────
# Genera el secreto con: openssl rand -base64 32
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"

# ─── Imagenes (obligatorio) ───────────────────────────────────────────────────
# Token de Vercel Blob para subir imagenes de productos y perfiles.
BLOB_READ_WRITE_TOKEN=""

# ─── MercadoPago (obligatorio) ────────────────────────────────────────────────
# Usa credenciales de prueba (TEST-...) en desarrollo.
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""
# Secreto del webhook configurado en el panel de MercadoPago.
MERCADOPAGO_WEBHOOK_SECRET=""
# Minutos que se reserva el stock de un pedido pendiente de pago (default 60).
ORDER_STOCK_RESERVATION_MINUTES="60"

# ─── Emails transaccionales con Resend (obligatorio) ─────────────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Harry's Boutique <noreply@tu-dominio.cl>"
# Correo que recibe los mensajes del formulario de contacto (opcional).
CONTACT_EMAIL=""

# ─── Supabase (opcional, solo si se usan helpers de Supabase) ────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# ─── Rate limiting distribuido con Upstash (opcional) ────────────────────────
# Sin estas variables se usa un limitador en memoria (valido solo en local).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Observabilidad (opcional) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_GA_ID=""

# ─── Instagram (opcional, worker `npm run instagram:process`) ─────────────────
INSTAGRAM_USER_ID=""
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_GRAPH_API_VERSION="v21.0"

# ─── Script `npm run admin:create` (solo al crear el primer admin) ────────────
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
ADMIN_ROLE="OWNER"

# ─── Checkout como invitado (opcional) ───────────────────────────────────────
# Firma los enlaces de seguimiento de pedidos de invitados; si falta se usa NEXTAUTH_SECRET.
GUEST_ORDER_SECRET=""

# ─── Mercado Libre (opcional, sincroniza publicaciones vinculadas) ───────────
# Crea la app en https://developers.mercadolibre.cl y registra como redirect URI:
# http://localhost:3000/api/admin/mercadolibre/callback
MERCADOLIBRE_CLIENT_ID=""
MERCADOLIBRE_CLIENT_SECRET=""
# Solo si la URI registrada difiere de NEXT_PUBLIC_FRONTEND_URL + /api/admin/mercadolibre/callback
MERCADOLIBRE_REDIRECT_URI=""
# Clave para cifrar los tokens en la base; si falta se deriva de NEXTAUTH_SECRET.
MERCADOLIBRE_TOKEN_SECRET=""
# Token que Vercel Cron envia como "Authorization: Bearer" a /api/cron/mercadolibre-sync.
CRON_SECRET=""
